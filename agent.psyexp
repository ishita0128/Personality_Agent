                <Param name="Begin Routine" val="choice = emotionKey.keys&#13;&#10;&#13;&#10;if choice == '1':&#13;&#10;    agent_reply = &quot;😊 Happy Agent: That sounds wonderful!&quot;&#13;&#10;&#13;&#10;elif choice == '2':&#13;&#10;    agent_reply = &quot;😬 Anxious Agent: That worry makes sense.&quot;&#13;&#10;&#13;&#10;elif choice == '3':&#13;&#10;    agent_reply = &quot;😢 Sad Agent: That sounds really hard.&quot;&#13;&#10;&#13;&#10;elif choice == '4':&#13;&#10;    agent_reply = &quot;😠 Angry Agent: Your feelings are valid.&quot;&#13;&#10;&#13;&#10;else:&#13;&#10;    agent_reply = &quot;No emotion selected.&quot;" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each Frame" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Routine" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
